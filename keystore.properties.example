# Copy this file to "keystore.properties" (at the project root, next to
# gradle.properties) and fill in your signing credentials.
#
# The real keystore.properties is gitignored and must NEVER be committed.
# Only the maintainer needs it — contributors build debug APKs without it.
#
# storeFile can be an absolute path, or a path relative to the project root.
# Point it at the keystore you already use for the Play Store release build.

storeFile=/absolute/path/to/your/release-key.jks
storePassword=your-store-password
keyAlias=your-key-alias
keyPassword=your-key-password
