# Built application files & build outputs
/build
/app/build
/app/release
*.apk
*.aab
*.ap_
*.dex

# Gradle
.gradle/
/local.properties
/build/

# Signing & keystores — NEVER commit
*.jks
*.keystore
# EXCEPTION: keystores/debug.keystore is a TEST-ONLY debug keystore that is
# deliberately committed so CI builds keep a stable signing SHA-1 for the
# Google OAuth client (alias androiddebugkey, standard android/android creds).
# It must never hold a release key. Release keystores stay ignored:
!keystores/debug.keystore
*.pem
*.p12
*.cer
*.crt
keystore.properties

# Secrets & credentials — NEVER commit
secrets.properties
*.env
.env.*
google-services.json
agconnect-services.json

# Native build
.externalNativeBuild
.cxx
/captures

# IDE / editor
*.iml
.idea/
.kotlin/
.DS_Store

# Misc
*.log
icon-build/
